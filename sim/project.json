{
  "schema_version": 1,
  "kind": "project",
  "name": "stm32-access-terminal",
  "description": "The access control terminal on a NUCLEO-F446RE: an MFRC522 card reader on SPI1, a 4x4 keypad, an SSD1306 OLED, a DS3231 clock and a 24LC256 EEPROM on I2C1, a servo lock on TIM2_CH3, a passive buzzer on TIM3_CH2, green and red LEDs, an exit button and the door's contact. The firmware is the CMake build's ELF (cmake --preset firmware && cmake --build --preset firmware). The I2C bus and the open-drain lines have pull-ups to 3.3 V (emblink/pull_up: the same resistance, kept out of the board's power network, which keeps the run fast).",
  "policy": "electrical",
  "boards": [
    {
      "id": "B1",
      "board": "emblink/nucleo_f446re",
      "layout": {
        "x": 360,
        "y": 120
      },
      "firmware": {
        "image": "../build/firmware/access-terminal.elf",
        "format": "elf"
      }
    }
  ],
