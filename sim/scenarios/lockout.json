  "assertions": [
    {
      "id": "added",
      "by": "1.9s",
      "probe": "console",
      "expect": {
        "contains": "user 0: Grace"
      }
    },
    {
      "id": "wrong",
      "by": "3.6s",
      "probe": "console",
      "expect": {
        "contains": "denied: wrong PIN (Grace)"
      }
    },
    {
      "id": "lockout",
      "by": "7.4s",
      "probe": "console",
      "expect": {
        "contains": "lockout (Grace)"
      }
    },
    {
      "id": "lockout-red",
      "at": "7.5s",
      "probe": "red",
      "expect": {
        "equals": true
      }
    },
    {
      "id": "still-locked-out",
      "by": "11s",
      "probe": "console",
      "expect": {
        "not_contains": "granted"
      }
    },
    {
      "id": "ignored",
      "at": "8.2s",
      "probe": "servo",
      "expect": {
        "max": 5
      }
    },
    {
      "id": "granted",
      "by": "14.5s",
      "probe": "console",
      "expect": {
        "contains": "granted (Grace)"
      }
    },
    {
      "id": "open",
      "at": "14.5s",
      "probe": "servo",
      "expect": {
        "min": 85
      }
    },
    {
      "id": "clean",
      "always": true,
      "diagnostics": {
        "forbid": [
          "mcu.clock_gated",
          "mcu.clock_out_of_spec",
          "mcu.flash_wait_states"
        ]
      }
    }
  ]
